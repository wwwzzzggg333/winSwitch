/* ---- Base ---- */
QWidget { font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif; }

QMainWindow,
QWidget#SwitcherPanel,
QWidget#PanelContent,
QWidget#FilterRow,
QWidget#ContentViewport,
QWidget#CardGridHost {
    background-color: #1a1b20;
    color: #eceff4;
}

QScrollArea#FilterScroll,
QScrollArea#ContentScroll {
    background-color: #1a1b20;
    border: none;
}

QScrollArea#FilterScroll {
    min-height: 48px;
    max-height: 48px;
}

QWidget#FilterViewport,
QWidget#FilterRow {
    background-color: #1a1b20;
}

QScrollArea#FilterScroll > QWidget > QWidget,
QScrollArea#ContentScroll > QWidget > QWidget {
    background-color: #1a1b20;
}

QWidget#EmptyState { background-color: #1a1b20; }
QLabel#EmptyStateGlyph { color: #667083; font-size: 34px; }
QLabel#EmptyStateTitle { color: #e1e5ec; font-size: 15px; font-weight: 600; }
QLabel#EmptyStateHint { color: #8b919e; font-size: 12px; }

QScrollBar:vertical {
    background: #1a1b20;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #3d4149;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #5a6070;
}

QScrollBar:horizontal {
    background: #1a1b20;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #3d4149;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a6070;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
}

/* ---- Search ---- */
QLineEdit#SearchEdit {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 10px;
    padding: 10px 14px;
    padding-right: 32px;
    color: #eceff4;
    font-size: 13px;
    selection-background-color: #4a90d9;
}

QLineEdit#SearchEdit:focus {
    border-color: #4a90d9;
}

QLineEdit#SearchEdit:hover {
    border-color: #4d5360;
}

/* ---- Filter pills ---- */
QFrame#FilterChip,
QFrame#FilterChipActive {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 16px;
}

QFrame#FilterChipActive {
    background-color: #3d7dd4;
    border-color: #3d7dd4;
}

QFrame#FilterChip QToolButton#FilterPill,
QFrame#FilterChipActive QToolButton#FilterPill {
    background-color: transparent;
    border: none;
    border-radius: 0;
    padding: 4px 8px 4px 12px;
    color: #c8cdd8;
    font-size: 12px;
}

QFrame#FilterChipActive QToolButton#FilterPill {
    color: #ffffff;
    font-weight: 600;
}

QFrame#FilterChip:hover {
    background-color: #2e323c;
    border-color: #4d5360;
}

QFrame#FilterChip QToolButton#FilterPill:hover,
QFrame#FilterChipActive QToolButton#FilterPill:hover {
    color: #ffffff;
}

QFrame#FilterChip QToolButton#FilterPill:checked,
QFrame#FilterChipActive QToolButton#FilterPill:checked {
    background-color: transparent;
    border: none;
}

QToolButton#FilterPill {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 16px;
    padding: 6px 14px;
    color: #c8cdd8;
    font-size: 12px;
}

QToolButton#FilterPill:hover {
    background-color: #2e323c;
    border-color: #4d5360;
    color: #eceff4;
}

QToolButton#FilterPill:checked {
    background-color: #3d7dd4;
    border-color: #3d7dd4;
    color: #ffffff;
    font-weight: 600;
}

QFrame#FilterChip QToolButton#CloseChip,
QFrame#FilterChipActive QToolButton#CloseChip {
    background-color: transparent;
    border: none;
    border-radius: 10px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    color: #8b919e;
    font-size: 14px;
    margin: 0;
}

QFrame#FilterChipActive QToolButton#CloseChip {
    color: rgba(255, 255, 255, 0.85);
}

QFrame#FilterChip QToolButton#CloseChip:hover,
QFrame#FilterChipActive QToolButton#CloseChip:hover {
    background-color: #c0392b;
    color: #ffffff;
}

QToolButton#CloseChip {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    min-width: 20px;
    max-width: 20px;
    min-height: 20px;
    max-height: 20px;
    padding: 0;
    color: #8b919e;
    font-size: 14px;
}

QToolButton#CloseChip:hover {
    background-color: #c0392b;
    border-color: #c0392b;
    color: #ffffff;
}

/* ---- Group headers ---- */
QLabel#GroupTitle {
    color: #eceff4;
    font-size: 14px;
    font-weight: 600;
    padding: 2px 0;
}

QLabel#GroupCount {
    color: #8b919e;
    font-size: 12px;
    padding: 2px 0;
}

QToolButton#GroupAction,
QToolButton#GroupCloseAction {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    padding: 4px 10px;
    color: #b8beca;
    font-size: 12px;
}

QToolButton#GroupAction:hover {
    background-color: #2e323c;
    border-color: #4d5360;
    color: #eceff4;
}

QToolButton#GroupCloseAction:hover {
    background-color: #4a2528;
    border-color: #a74349;
    color: #ffe9ea;
}

QToolButton#GroupActionPinned {
    background-color: #2a3545;
    border: 1px solid #3d7dd4;
    border-radius: 8px;
    padding: 4px 10px;
    color: #7eb6ff;
    font-size: 12px;
}

/* ---- Window cards ---- */
QWidget#WindowCard {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 10px;
}

QWidget#WindowCard:hover {
    border-color: #4d5360;
    background-color: #2a2e38;
}

QWidget#WindowCard[selected="true"] {
    border: 1px solid #4a90d9;
    background-color: #2a3545;
}

QWidget#ThumbBox {
    background-color: #14161a;
    border-radius: 8px;
    border: 1px solid #2a2e38;
}

QWidget#ThumbnailFallback { background-color: #181c22; }
QLabel#ThumbnailFallbackGlyph { color: #8d96a6; font-size: 28px; }
QLabel#ThumbnailStatus { color: #7f8999; font-size: 11px; }

QLabel#CardTitle {
    color: #eceff4;
    font-size: 12px;
    padding: 0 2px;
}

QLabel#CardPath {
    color: #8b919e;
    font-size: 11px;
    padding: 0 2px;
}

QToolButton#CardClose {
    background-color: rgba(30, 32, 38, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    padding: 0;
    color: #d0d4dc;
    font-size: 14px;
    font-weight: bold;
}

QToolButton#CardClose:hover {
    background-color: #c0392b;
    border-color: #c0392b;
    color: #ffffff;
}

/* ---- Settings ---- */
QLabel#SettingsTitle {
    color: #eceff4;
    font-size: 18px;
    font-weight: 600;
    padding-bottom: 4px;
}

QTabWidget::pane {
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    background: #1a1b20;
    top: -1px;
}

QTabBar::tab {
    background: #252830;
    color: #8b919e;
    border: 1px solid #3a3f4b;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1a1b20;
    color: #eceff4;
    border-bottom: 1px solid #1a1b20;
}

QTabBar::tab:hover:!selected {
    background: #2e323c;
    color: #eceff4;
}

QPlainTextEdit, QCheckBox, QRadioButton, QLabel {
    color: #eceff4;
}

QPlainTextEdit {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    padding: 6px;
}

QGroupBox {
    color: #b8beca;
    border: 1px solid #3a3f4b;
    border-radius: 8px;
    margin-top: 8px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

QPushButton {
    background-color: #3d7dd4;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4a8ee6;
}

QPushButton:pressed {
    background-color: #2f6bb8;
}

QPushButton#SecondaryButton {
    background-color: #252830;
    border: 1px solid #3a3f4b;
    color: #c8cdd8;
}

QPushButton#SecondaryButton:hover {
    background-color: #2e323c;
    color: #eceff4;
}

/* ---- Dialogs ---- */
QDialog#AppMessageBox {
    background-color: #1a1b20;
}

QLabel#AppMessageText {
    color: #eceff4;
    font-size: 13px;
    padding-top: 4px;
}

QDialogButtonBox#AppMessageButtons QPushButton {
    min-width: 72px;
}

QDialog {
    background-color: #1a1b20;
}

QDialog QLabel {
    color: #eceff4;
    background-color: transparent;
    font-size: 13px;
}
